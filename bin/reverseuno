#!/usr/bin/env bash
# Small control client for the running reverseuno app.
set -euo pipefail

CONFIG="${REVERSEUNO_CONTROL_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/reverseuno/control.json}"

if [[ ! -f "$CONFIG" ]]; then
  echo "reverseuno is not running (no $CONFIG). Start it with: npm start" >&2
  exit 1
fi

# This runs on every Right Super press and release, so keep it to jq + curl:
# starting Python twice per keypress added noticeable latency to push-to-talk.
command -v jq >/dev/null || { echo "reverseuno: jq is required (pacman -S jq)" >&2; exit 1; }
read -r PORT TOKEN < <(jq -r '"\(.port) \(.token)"' "$CONFIG")

usage() {
  cat <<'EOF'
usage: reverseuno <command> [args]

  start              start listening (push-to-talk press)
  stop               stop listening, transcribe, format, paste (release)
  toggle             start if idle, stop if listening
  cancel             discard the current recording
  state              print the current state as JSON
  health             check whether the app is reachable
  show [page]        open the hub (home, dictionary, snippets, style, settings)
  devices            list audio input devices
  device <id>        select an audio input by device id
  paste <text>       insert text at the focused cursor
  lang <code|cycle>  set the dictation language
  quit               quit reverseuno
EOF
}

# One-field JSON object with the value safely escaped: obj <key> <value>
obj() {
  jq -cn --arg k "$1" --arg v "$2" '{($k): $v}'
}

command="${1:-}"
shift || true

method="POST"
path="/${command}"
data="{}"

case "$command" in
  start|stop|toggle|cancel|quit) ;;
  state|health)
    method="GET"
    data=""
    ;;
  devices)
    method="GET"
    path="/devices"
    data=""
    ;;
  device)
    id="${1:-}"
    if [[ -z "$id" ]]; then
      echo "usage: reverseuno device <id>" >&2
      exit 2
    fi
    path="/device"
    data=$(obj id "$id")
    ;;
  show)
    page="${1:-home}"
    path="/show"
    data=$(obj page "$page")
    ;;
  paste)
    text="${1:-}"
    if [[ -z "$text" ]]; then
      text="$(cat)"
    fi
    path="/paste"
    data=$(obj text "$text")
    ;;
  lang)
    value="${1:-cycle}"
    path="/language"
    if [[ "$value" == "cycle" ]]; then
      data='{"cycle":true}'
    else
      data=$(obj language "$value")
    fi
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

args=(-sS --max-time 30 -X "$method" -H "Authorization: Bearer $TOKEN" -H 'Content-Type: application/json')
if [[ -n "$data" ]]; then
  args+=(-d "$data")
fi

curl "${args[@]}" "http://127.0.0.1:${PORT}${path}"
echo
